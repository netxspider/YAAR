# Gnani speech APIs (Prisma STT, Timbre TTS). Create a key at https://app.gnani.ai/voice
GNANI_API_KEY=

# Reasoning model, in order of preference. YAAR uses the first one configured.

# Option A: Gnani Evon v3.3 (open weights, gnani/gnani-evon-v3.3-30B-A3B), served with vLLM:
#   vllm serve gnani/gnani-evon-v3.3-30B-A3B --port 8000
# EVON_BASE_URL=http://localhost:8000/v1
# EVON_API_KEY=
# EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B

# Option B: Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Option C: any other OpenAI-compatible server.
# LLM_BASE_URL=https://your-server/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-name
